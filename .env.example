DATABASE_URL=postgres://magic:magic@localhost:5434/magic_events
# Read only by the tests. The tests empty every table in it.
TEST_DATABASE_URL=postgres://magic:magic@localhost:5434/magic_events_test
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
# The host names the MCP endpoint answers to, comma-separated.
API_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
NEXT_PUBLIC_API_URL=http://localhost:4000

# fatal, error, warn, info, debug, trace or silent. The tests are silent unless it is set.
# LOG_LEVEL=info
LOG_PRETTY=true

# Requests one address may make in a window, before any API key is checked. Set high: version 1 is one instance,
# and the limits are there to stop a runaway client, not to meter use.
API_RATE_LIMIT_MAX=10000
API_RATE_LIMIT_WINDOW_SECONDS=60
API_BODY_LIMIT_BYTES=65536

# At least 32 characters. Generate one with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Requests one API key may make in a window. A key gets these when it is issued.
API_KEY_RATE_LIMIT_MAX=10000
API_KEY_RATE_LIMIT_WINDOW_SECONDS=60

SEARCH_DEFAULT_RADIUS_KM=60
SEARCH_MAX_RADIUS_KM=200

# What a new source gets: fetched once a week, removed after 3 complete runs without it, 3 processing attempts.
DISCOVERY_DEFAULT_FETCH_INTERVAL_HOURS=168
DISCOVERY_DEFAULT_MISSED_RUNS_BEFORE_REMOVAL=3
DISCOVERY_DEFAULT_MAX_PROCESSING_ATTEMPTS=3
# When the schedule looks for sources that are due, as a cron expression in UTC: every 15 minutes.
DISCOVERY_SCHEDULE_CRON=*/15 * * * *
# A failed fetch is tried again 5 times: after 15, 30, 60, 120 and 240 minutes.
DISCOVERY_FETCH_RETRIES=5
DISCOVERY_FETCH_RETRY_BACKOFF_MINUTES=15
# How long a fetch waits for a source to answer, and how long a whole run may take.
DISCOVERY_FETCH_TIMEOUT_SECONDS=30
DISCOVERY_RUN_TIMEOUT_MINUTES=60
# The User-Agent the source adapters send.
DISCOVERY_USER_AGENT=Mozilla/5.0 (compatible; magic-events/1.0)
# How far ahead experiences are sourced, and how far ahead recurring sessions are generated.
DISCOVERY_HORIZON_MONTHS=24
CATALOGUE_SESSION_HORIZON_MONTHS=24
# When Catalogue's upkeep runs, as a cron expression in UTC: finished experiences to Past, bookings past their close
# time to Closed, and recurring sessions generated further ahead.
CATALOGUE_UPKEEP_CRON=0 * * * *
# The API keys of the two sources that have an API. A source row names the variable.
QUICKET_API_KEY=
TICKETMASTER_API_KEY=

PROCESSING_WORKERS=1

# The language model, used to extract and classify experiences and to find the current calendar file.
LANGUAGE_MODEL_PROVIDER=anthropic
LANGUAGE_MODEL=claude-opus-5-5
LANGUAGE_MODEL_TIMEOUT_SECONDS=600
ANTHROPIC_API_KEY=
ANTHROPIC_EFFORT=medium

# The embedding model, which embeds experiences and the query texts of searches.
EMBEDDING_PROVIDER=bedrock
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# How many experiences one round of embedding takes.
EMBEDDING_BATCH_SIZE=100
# How long a search waits for its query's embedding before it ranks by keyword alone.
EMBEDDING_QUERY_TIMEOUT_SECONDS=5
# The region Bedrock is called in, needed only where embeddings are made. The credentials come from the AWS SDK's
# default chain: these access keys, a profile or a role.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
