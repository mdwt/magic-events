{
  "name": "@magic-events/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./migrate": "./src/migrate.ts"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc",
    "lint": "eslint .",
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../.env src/cli/migrate.ts DATABASE_URL",
    "migrate:test": "node --env-file-if-exists=../../.env src/cli/migrate.ts TEST_DATABASE_URL",
    "snapshot:save": "node --env-file-if-exists=../../.env src/cli/snapshot.ts save",
    "snapshot:restore": "node --env-file-if-exists=../../.env src/cli/snapshot.ts restore",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0"
  }
}
