{
  "name": "@magic-events/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "node --env-file-if-exists=../../.env --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "pipeline": "node --env-file-if-exists=../../.env src/pipeline.ts",
    "captures": "node --env-file-if-exists=../../.env src/load-captures.ts",
    "seed": "node --env-file-if-exists=../../.env src/seed/run.ts",
    "seed:samples": "node --env-file-if-exists=../../.env src/seed/run.ts --samples"
  },
  "dependencies": {
    "@magic-events/core": "workspace:*",
    "@magic-events/db": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0"
  }
}
