{
  "name": "magic-events",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "quickstart": "pnpm db:up && pnpm db:restore && pnpm db:seed",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @magic-events/db generate",
    "db:migrate": "pnpm --filter @magic-events/db migrate",
    "db:migrate:test": "pnpm --filter @magic-events/db migrate:test",
    "db:snapshot": "pnpm --filter @magic-events/db snapshot:save",
    "db:restore": "pnpm --filter @magic-events/db snapshot:restore",
    "db:seed": "pnpm --filter @magic-events/cli seed",
    "db:seed:samples": "pnpm --filter @magic-events/cli seed:samples",
    "db:studio": "pnpm --filter @magic-events/db studio",
    "cli:pipeline": "pnpm --filter @magic-events/cli run pipeline",
    "cli:admin": "pnpm --filter @magic-events/cli run admin",
    "cli:captures": "pnpm --filter @magic-events/cli run captures",
    "e2e": "pnpm --filter @magic-events/e2e e2e",
    "e2e:live": "pnpm --filter @magic-events/e2e e2e:live",
    "openapi": "pnpm --filter @magic-events/api openapi",
    "openapi:check": "pnpm --filter @magic-events/api openapi:check",
    "tunnel": "cloudflared tunnel --url http://localhost:4000"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
